//@version=5
// ═════════════════════════════════════════════════ Properties ─────────────
//  GOLDEN-PIVOT φ v2  [BITMOON618 × CRYPTO INSTITUTE]
//  هسته‌ی هندسی φ (ناحیه‌ی طلایی 0.618 سوئینگ ۹۶ کندلی) + ژن حجم HIVE (volr≥1.3)
//  منطق دقیق بک‌تست: merge_gp.py / golden.py H1  |  نماد: BYBIT:BTCUSDT.P  TF: 15m
//  انتظار بک‌تست ۵۲ روزه: ~۳۷ معامله | WR≈46% | PF≈2.4-3.1 | OOS مثبت | 4/4 walk-forward
//
//  ⚠ صداقت مدل: سفارش لیمیتِ پرنشده بعد از cancelBars کندل لغو می‌شود.
//  کارمزد 0.0375% هر طرف + اسلیپیج 2 تیک (سناریوی تنش که در بک‌تست پاس شد).
// ═══════════════════════════════════════════════════════════════════════════
strategy("GOLDEN-PIVOT φ v2 [BITMOON618]",
     shorttitle        = "GP-φv2",
     overlay           = true,
     initial_capital   = 500,
     currency          = currency.USD,
     default_qty_type  = strategy.percent_of_equity,
     default_qty_value = 100,
     commission_type   = strategy.commission.percent,
     commission_value  = 0.0375,
     slippage          = 2,
     calc_on_order_fills = false,
     process_orders_on_close = false,
     pyramiding        = 0)

// ── ورودی‌ها ────────────────────────────────────────────────────────────────
grpS = "● هسته‌ی سیگنال (هندسه‌ی φ)"
lookback = input.int(96, "طول سوئینگ (کندل)", minval = 10, group = grpS)
retFrac  = input.float(0.618, "ریتریس فیبوناچی (0.618=طلایی)", minval = 0.1, maxval = 0.9, step = 0.001, group = grpS)

grpH = "● فیلتر HIVE (ژن آرشیو Indicator 1405)"
volrMin  = input.float(1.3, "حداقل نسبت حجم به میانگین ۲۰ کندل", minval = 0.5, step = 0.1, group = grpH)

grpR = "● ریسک و خروج"
slAtr      = input.float(2.0, "استاپ (× ATR14)", minval = 0.5, step = 0.1, group = grpR)
tpMult     = input.float(1.0, "هدف (× دامنه‌ی سوئینگ)", minval = 0.3, step = 0.1, group = grpR)
maxHold    = input.int(128, "حداکثر نگهداری (کندل)", minval = 10, group = grpR)
riskPct    = input.float(2.0, "ریسک هر معامله (٪ اکوییتی)", minval = 0.1, step = 0.1, group = grpR)
maxLev     = input.float(10.0, "سقف اهرم (× اکوییتی)", minval = 1.0, step = 0.5, group = grpR)
cancelBars = input.int(3, "لغو لیمیت پرنشده پس از N کندل", minval = 1, group = grpR)

// ── محاسبات هسته ────────────────────────────────────────────────────────────
// پنجره‌ی سوئینگ شامل کندل جاری (مطابق بک‌تست: candles[i-96..i] = 97 کندل)
swHi = ta.highest(high, lookback + 1)
swLo = ta.lowest(low, lookback + 1)
rng  = swHi - swLo

// ATR14 وایلدر (مطابق بک‌تست)
atr14 = ta.atr(14)

// نسبت حجم HIVE: حجم کندل جاری ÷ میانگین ۲۰ کندلِ قبل (بدون خودش)
volAvg = math.sum(volume, 20)[1] / 20
volr   = volAvg > 0 ? volume / volAvg : 0.0

// ناحیه‌ی طلایی
zone = swLo + retFrac * rng

// ── شرط سیگنال (مطابق بک‌تست، ارزیابی روی کندل بسته) ───────────────────────
touched = low  <= zone
closed  = close > zone
upCandle = close > close[1]
volOK    = volr >= volrMin
rngOK    = rng > 0

sigRaw  = touched and closed and upCandle and volOK and rngOK

// ── مدیریت سفارش (میکر لیمیت روی zone، یک پوزیشن هم‌زمان) ──────────────────
var float workZone = na
var float workStop = na
var float workTgt  = na
var int   workBar  = na

canPlace = sigRaw and strategy.position_size == 0 and strategy.position_size[1] == 0

if canPlace
    stopDist = slAtr * atr14
    // سایزینگ بر اساس استاپ: qty = (اکوییتی × ریسک٪) ÷ فاصله‌ی استاپ، سقف اهرم
    qtyRaw = stopDist > 0 ? (strategy.equity * riskPct / 100.0) / stopDist : 0.0
    qtyCap = strategy.equity * maxLev / zone
    q      = math.min(qtyRaw, qtyCap)
    if q > 0
        workZone := zone
        workStop := zone - stopDist
        workTgt  := zone + tpMult * rng
        workBar  := bar_index
        strategy.entry("GP", strategy.long, qty = q, limit = workZone)

// لغو سفارش کهنه‌ی پرنشده
if strategy.position_size == 0 and not na(workBar) and bar_index - workBar >= cancelBars
    strategy.cancel("GP")

// ست‌کردن استاپ/هدف به محض پر شدن لیمیت (سطوح مطلقِ ذخیره‌شده = منطق بک‌تست)
justFilled = strategy.position_size > 0 and strategy.position_size[1] <= 0
if justFilled and not na(workStop)
    strategy.exit("X", "GP", stop = workStop, limit = workTgt, qty_percent = 100)

// خروج زمانی
inTrade  = strategy.position_size > 0
barsIn   = inTrade ? bar_index - strategy.opentrades.entry_bar_index(0) : 0
if inTrade and barsIn >= maxHold
    strategy.close("GP", comment = "TIME-EXIT")

// ── نمایش گرافیکی ───────────────────────────────────────────────────────────
plot(swHi, "سقف سوئینگ", color = color.new(color.gray, 60))
plot(swLo, "کف سوئینگ",  color = color.new(color.gray, 60))
plot(zone, "ناحیه‌ی طلایی 0.618", color = color.new(color.orange, 0), linewidth = 2)
plotshape(sigRaw and strategy.position_size == 0, "سیگنال", style = shape.triangleup, location = location.belowbar, color = color.new(color.lime, 0), size = size.tiny)
plotshape(volOK, "تایید HIVE", style = shape.circle, location = location.bottom, color = color.new(color.aqua, 40), size = size.tiny)
bgcolor(sigRaw ? color.new(color.green, 88) : na)

// ── داشبورد ─────────────────────────────────────────────────────────────────
var table dash = table.new(position.top_right, 2, 6, bgcolor = color.new(color.black, 20), border_width = 1)
if barstate.islast
    table.cell(dash, 0, 0, "GP-φv2", text_color = color.orange, text_size = size.small)
    table.cell(dash, 1, 0, timeframe.period + "m", text_color = color.silver, text_size = size.small)
    table.cell(dash, 0, 1, "volr", text_color = color.silver, text_size = size.small)
    table.cell(dash, 1, 1, str.tostring(volr, "#.##") + (volOK ? " ✓" : " ✗"), text_color = volOK ? color.lime : color.red, text_size = size.small)
    table.cell(dash, 0, 2, "zone", text_color = color.silver, text_size = size.small)
    table.cell(dash, 1, 2, str.tostring(zone, format.mintick), text_color = color.orange, text_size = size.small)
    table.cell(dash, 0, 3, "stop", text_color = color.silver, text_size = size.small)
    table.cell(dash, 1, 3, str.tostring(zone - slAtr * atr14, format.mintick), text_color = color.red, text_size = size.small)
    table.cell(dash, 1, 4, str.tostring(zone + tpMult * rng, format.mintick), text_color = color.lime, text_size = size.small)
    table.cell(dash, 0, 4, "target", text_color = color.silver, text_size = size.small)
    table.cell(dash, 0, 5, "position", text_color = color.silver, text_size = size.small)
    table.cell(dash, 1, 5, strategy.position_size > 0 ? "IN TRADE" : "FLAT", text_color = strategy.position_size > 0 ? color.lime : color.gray, text_size = size.small)
